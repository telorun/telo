{
  "name": "@telorun/cel",
  "version": "0.136.0",
  "description": "The Common Expression Language for Telo: read, type-check and evaluate an expression, hold it as a tree, write it back.",
  "keywords": [
    "telo",
    "cel",
    "expression",
    "parser"
  ],
  "author": "Bartosz Pasiński <bartosz.pasinski@codenet.pl>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telorun/telo.git",
    "directory": "cel/nodejs"
  },
  "homepage": "https://github.com/telorun/telo#readme",
  "bugs": {
    "url": "https://github.com/telorun/telo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**"
  ],
  "scripts": {
    "build": "node ../../scripts/generate-telo-version.mjs && tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:conformance": "vitest run --config vitest.conformance.config.ts",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "check:browser-safe": "node scripts/check-browser-safe.mjs",
    "check:signatures": "pnpm run build && node scripts/check-signatures.mjs",
    "prepack": "node ../../scripts/pack-backup.mjs . --save src/engine-version.ts dist && node ../../scripts/generate-telo-version.mjs --published && tsc -p tsconfig.lib.json && node ../../scripts/check-pack-identity.mjs cel && cp ../LICENSE . && node ../../scripts/rewrite-pack-links.mjs .",
    "postpack": "node ../../scripts/rewrite-pack-links.mjs . --restore && rm -f LICENSE && node ../../scripts/pack-backup.mjs . --restore"
  },
  "dependencies": {
    "d3-format": "catalog:",
    "re2js": "2.8.3",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@types/d3-format": "^3.0.4",
    "@types/node": "^20.0.0",
    "esbuild": "catalog:",
    "typescript": "^5.0.0",
    "vitest": "^2.1.8"
  }
}
