    "properties": {
      "session": {
        "type": "string",
        "minLength": 1
      },
      "channelId": {
        "type": "string",
        "minLength": 1
      },
      "bytes": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required": [
      "session",
      "channelId",
      "bytes"
    ],
    "additionalProperties": false
  },
  "response": null,
  "errors": [],
  "synchronous": false,
  "reentrant": false
}
