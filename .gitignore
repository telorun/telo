# Runtime artifacts
tmp/
*.db
# authoring-agent writes into a process-cwd-relative ./workspace (e.g. the repo
# root when tests run from there); its output is scratch, never committed.
/workspace/

# Generated docs (rebuilt on every docusaurus build)
examples/INDEX.md
docs/cel-reference.md
docs/reference/standard-library.md

# Common
.DS_Store
Thumbs.db
.telo-debug/
.telo/
.telo.debug.jsonl
.cache
.env.local
/.env

# AI Agents
.codex
.claude/*.lock

# NodeJS
node_modules/
dist
app-dist

# Bundled controllers (pkg:telo/local/js) — build artifacts emitted by
# `pnpm run build:bundles`, packed into the module artifact at publish time.
modules/*/nodejs/*.mjs

# Migration entries copied in from analyzer/migrations/ by the analyzer's
# `prepare`. The canonical files live there so every kernel embeds the same
# bytes; TypeScript can only import a JSON file from inside its own package.
analyzer/nodejs/src/migrations/entries/

# Value-type entries copied in from sdk/value-types/ by the SDK's `prepare`.
# Same reason, same mechanism: every runtime reads the identical vocabulary.
sdk/nodejs/src/value-types/entries/

# Zone-attribute entries copied in from sdk/zone-attributes/ by the root
# `prepare`. Same reason, same mechanism: both kernels read one vocabulary.
sdk/nodejs/src/zone-attributes/entries/

# Manifest surface generation, generated from the linked kernel version by the
# root `prepare`. Committing it would be a second place the version lives.
analyzer/nodejs/src/telo-version.ts

# Python
python/__pycache__/
python/*.py[cod]
python/*.pyo
python/*.pyd
python/env/
python/venv/
python/ENV/
python/.venv/

# Go
go/bin/
go/*/*.exe
go/*/*.exe~
go/*/*.dll
go/*/*.so
go/*/*.dylib
go/*/vendor/

# Rust
target/
rust/target/
rust/*/target/
rust/*.rs.bk
rust/*.rlib
rust/*.rmeta
rust/*.d
rust/*.lock
rust/*.so
rust/*.dll
rust/*.dylib
