{
  "name": "Runtime.Cancel",
  "direction": "controller-to-kernel",
  "spec": "9. Host facilities",
  "request": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "Stop a child and tear it down. Idempotent, and safe after it has already finished.",
    "type": "object",
    "properties": {
      "instance": {
        "type": "string",
        "minLength": 1
      },
      "run": {
        "type": "string",
        "minLength": 1
      },
      "reason": {
        "type": "string"
      }
    },
    "required": [
      "instance",
      "run"
    ],
    "additionalProperties": false
  },
  "response": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "Torn down. A caller that must know the child released its ports and files waits for this.",
    "type": "object",
    "additionalProperties": false
  },
  "errors": [],
  "synchronous": false,
  "reentrant": false
}
