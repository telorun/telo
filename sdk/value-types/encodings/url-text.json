        "scheme": "postgres",
        "host": "db.internal",
        "port": 5432,
        "user": "app",
        "password": "s3cret",
        "path": "/orders",
        "query": {
          "sslmode": "require"
        }
      },
      "canonical": "postgres://app:s3cret@db.internal:5432/orders?sslmode=require"
    },
