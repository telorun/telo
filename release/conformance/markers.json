  {
    "name": "polyglot-component",
    "files": {
      "telo-workspace.yaml": "release:\n  maxBump: minor\n  ignore: ['**/notes/**']\n  units:\n    - path: engine\n      ecosystem: { npm: nodejs, cargo: [rust, rust/value] }\n      version: nodejs/package.json\n      versionFiles: ['meta/*.version', { path: meta/info.json, pointer: /release/version }]\n      payload: [rust/abi/**]\n      metafile: nodejs/meta.json\n",
      "engine/nodejs/package.json": "{\n  \"name\": \"@fx/engine\",\n  \"version\": \"0.3.0\"\n}\n",
      "engine/rust/Cargo.toml": "[package]\nname = \"fx-engine\"\nversion = \"0.3.0\"\nedition = \"2021\"\n",
      "engine/rust/value/Cargo.toml": "[package]\nname = \"fx-engine-value\"\nversion = \"0.3.0\"\nedition = \"2021\"\n",
      "engine/rust/abi/lib.rs": "\n",
      "engine/meta/a.version": "0.3.0\n",
      "engine/meta/info.json": "{ \"release\": { \"version\": \"0.3.0\" } }\n"
    },
    "expected": {
      "diagnostics": [],
      "units": [
        {
          "key": "engine",
          "dir": "engine",
          "anchors": [
            {
              "ecosystem": "cargo",
              "anchor": "rust",
              "dir": "engine/rust",
              "name": "fx-engine",
              "contributesLayer": true,
              "versionFiles": [],
              "settings": {}
            },
            {
              "ecosystem": "cargo",
              "anchor": "rust/value",
              "dir": "engine/rust/value",
              "name": "fx-engine-value",
              "contributesLayer": true,
              "versionFiles": [],
              "settings": {}
            },
            {
              "ecosystem": "npm",
              "anchor": "nodejs",
              "dir": "engine/nodejs",
              "name": "@fx/engine",
              "contributesLayer": true,
              "versionFiles": [],
              "settings": {}
            }
          ],
          "version": "engine/nodejs/package.json",
          "versionLocations": [
            "engine/nodejs/package.json",
            "engine/rust/Cargo.toml",
            "engine/rust/value/Cargo.toml",
            "engine/meta/a.version",
            "engine/meta/info.json#/release/version"
          ],
          "payload": {
            "patterns": [
              "rust/abi/**"
            ]
          },
          "metafile": "engine/nodejs/meta.json",
          "ignore": [
            "**/notes/**"
          ],
          "maxBump": "minor",
          "group": null
        }
      ]
    }
  },
  {
    "name": "version-unresolved",
    "files": {
      "telo-workspace.yaml": "release:\n  units:\n    - { path: napi, ecosystem: [npm, cargo] }\n    - { path: img, ecosystem: docker }\n    - { path: bare }\n",
      "napi/package.json": "{\n  \"name\": \"napi\",\n  \"version\": \"1.0.0\"\n}\n",
      "napi/Cargo.toml": "[package]\nname = \"napi\"\nversion = \"1.0.0\"\nedition = \"2021\"\n",
      "img/Dockerfile": "FROM scratch\n"
    },
    "expected": {
      "diagnostics": [
        {
          "code": "WORKSPACE_UNIT_VERSION_UNRESOLVED",
          "severity": "error",
          "message": "telo-workspace.yaml: 'release.units.0' (napi) declares no 'version:' and 2 anchors keep one (npm at ., cargo at .). Declare 'version:', naming the one that holds the unit's version.",
          "path": [
            "release",
            "units",
            0
          ]
        },
        {
          "code": "WORKSPACE_UNIT_VERSION_UNRESOLVED",
          "severity": "error",
          "message": "telo-workspace.yaml: 'release.units.1' (img) declares no 'version:' and none of its ecosystems (docker) keeps a version. Declare 'version:', naming the file that holds it.",
          "path": [
            "release",
            "units",
            1
          ]
        },
        {
          "code": "WORKSPACE_UNIT_PAYLOAD_EMPTY",
          "severity": "error",
          "message": "telo-workspace.yaml: 'release.units.2' (bare) lists no ecosystem and declares no 'payload:', so nothing it ships can be digested. List the ecosystem it ships through, declare 'payload:', or exclude it with '!'.",
          "path": [
            "release",
            "units",
            2
          ]
        },
        {
          "code": "WORKSPACE_UNIT_VERSION_UNRESOLVED",
          "severity": "error",
          "message": "telo-workspace.yaml: 'release.units.2' (bare) declares no 'version:' and lists no ecosystem. Declare 'version:', naming the file that holds it.",
          "path": [
            "release",
            "units",
            2
          ]
        }
      ],
      "units": []
    }
  },
  {
    "name": "ecosystem-unavailable",
    "ecosystemHosts": {
      "telo": "the `telo` CLI (`telo release`), which serves Telo modules"
    },
    "files": {
      "telo-workspace.yaml": "release:\n  ecosystems: { telo: { registry: oci://ghcr.io/acme }, pip: {} }\n  units:\n    - { path: modules/*, ecosystem: telo }\n    - { path: py, ecosystem: pip, version: VERSION }\n"
    },
    "expected": {
      "diagnostics": [
        {
          "code": "WORKSPACE_ECOSYSTEM_UNAVAILABLE",
          "severity": "error",
          "message": "telo-workspace.yaml: the 'telo' ecosystem is not served here — no adapter for it is registered in this host, so it cannot be planned. Run the release through the `telo` CLI (`telo release`), which serves Telo modules.",
          "path": [
            "release",
            "ecosystems",
            "telo"
          ]
        },
        {
          "code": "WORKSPACE_ECOSYSTEM_UNAVAILABLE",
          "severity": "error",
          "message": "telo-workspace.yaml: the 'pip' ecosystem is not served here — no adapter for it is registered in this host, so it cannot be planned. Run the release through a host that serves 'pip'. Served here: npm, cargo, docker, helm.",
          "path": [
            "release",
            "ecosystems",
            "pip"
          ]
        },
        {
          "code": "WORKSPACE_ECOSYSTEM_UNAVAILABLE",
          "severity": "error",
          "message": "telo-workspace.yaml: the 'telo' ecosystem is not served here — no adapter for it is registered in this host, so it cannot be planned. Run the release through the `telo` CLI (`telo release`), which serves Telo modules.",
          "path": [
            "release",
            "units",
            0,
            "ecosystem"
          ]
        },
        {
          "code": "WORKSPACE_ECOSYSTEM_UNAVAILABLE",
          "severity": "error",
          "message": "telo-workspace.yaml: the 'pip' ecosystem is not served here — no adapter for it is registered in this host, so it cannot be planned. Run the release through a host that serves 'pip'. Served here: npm, cargo, docker, helm.",
          "path": [
            "release",
            "units",
            1,
            "ecosystem"
          ]
        }
      ],
      "units": []
    }
  },
