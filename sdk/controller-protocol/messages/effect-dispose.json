{
  "name": "Effect.Dispose",
  "direction": "controller-to-kernel",
  "spec": "5. Lifecycle",
  "request": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "Run this effect's inverse now and take it off its frame. Idempotent, unordered, and never cascading.",
    "type": "object",
    "properties": {
      "instance": {
        "type": "string",
        "minLength": 1
      },
      "effect": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "instance",
      "effect"
    ],
    "additionalProperties": false
  },
  "response": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "Disposed. A refusing inverse is raised here, because a disposal has a caller.",
    "type": "object",
    "additionalProperties": false
  },
  "errors": [],
  "synchronous": false,
  "reentrant": true
}
