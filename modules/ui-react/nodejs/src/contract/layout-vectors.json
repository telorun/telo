    "vectors": [
      {
        "name": "reports onEndReached when its Load more is pressed, and from the keyboard",
        "steps": [
          {
            "click": {
              "part": "load-more"
            }
          },
          {
            "expect": {
              "intents": [
                [
                  "onEndReached"
                ]
              ]
            }
          },
          {
            "focus": {
              "part": "load-more"
            }
          },
          {
            "key": "Enter"
          },
          {
            "expect": {
              "intents": [
                [
                  "onEndReached"
                ]
              ]
            }
          }
        ]
      },
      {
        "name": "draws each record's content in order, and no Load more once nothing further exists",
        "props": {
          "hasMore": false,
          "total": 2
        },
        "steps": [
          {
            "expect": {
              "text": [
                {
                  "of": {
                    "part": "list-item",
                    "index": 0
                  },
                  "value": "Write the plan"
                },
                {
                  "of": {
                    "part": "list-item",
                    "index": 1
                  },
                  "value": "Review the plan"
                }
              ],
              "absent": [
                {
                  "part": "load-more"
                }
              ]
            }
          }
        ]
      },
      {
        "name": "reports a sort by a property, then by it descending",
        "steps": [
          {
            "click": {
              "part": "listing-sort-option"
            }
          },
          {
            "expect": {
              "intents": [
                [
                  "onSortChange",
                  "text"
                ]
              ]
            }
          },
          {
            "props": {
              "sort": {
                "value": "text",
                "sortable": [
                  {
                    "property": "text",
                    "label": "Task"
                  }
                ]
              }
            }
          },
          {
            "expect": {
              "attributes": [
                {
                  "of": {
                    "part": "listing-sort-option"
                  },
                  "name": "aria-pressed",
                  "value": "true"
                }
              ]
            }
          },
          {
            "click": {
              "part": "listing-sort-option"
            }
          },
          {
            "expect": {
              "intents": [
                [
                  "onSortChange",
                  "-text"
                ]
              ]
            }
          }
        ]
      },
      {
        "name": "draws the empty node where the records would be when the reads answer none",
        "props": {
          "records": [],
          "total": 0,
          "hasMore": false
        },
        "steps": [
          {
            "expect": {
              "text": [
                {
                  "of": {
                    "part": "listing-empty"
                  },
                  "value": "Nothing to do."
                }
              ]
            }
          }
        ]
      }
    ]
