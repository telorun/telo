      "frame": "0000004e01000000497b226964223a312c227061796c6f6164223a7b22696e7374616e6365223a226831227d2c2273657373696f6e223a227331222c2274797065223a22486f6c642e416371756972ff227d",
      "reason": "a lone 0xff byte stands where the meta's UTF-8 text should be"
    },
    {
      "name": "a message frame with a non-empty data region",
      "frame": "0000004f01000000497b226964223a312c227061796c6f6164223a7b22696e7374616e6365223a226831227d2c2273657373696f6e223a227331222c2274797065223a22486f6c642e41637175697265227d21",
      "reason": "a message frame's whole content is its envelope; only a data frame carries bytes after the meta"
