      {
        "args": [
          "baseline"
        ],
        "expected": {
          "exitCode": 0,
          "payload": {
            "ok": true,
            "recorded": [
              {
                "key": "app",
                "version": "1.0.0"
              },
              {
                "key": "lib",
                "version": "0.3.0"
              }
            ],
            "skipped": [],
            "unrecorded": [
