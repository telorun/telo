[
  {
    "name": "pypi: order publishes a dependency first, each to its index",
    "files": {
      "telo-workspace.yaml": "release:\n  ecosystems: { pypi: { registry: https://pypi.org/simple } }\n  units:\n    - { path: apps/api, ecosystem: pypi }\n    - { path: apps/worker, ecosystem: pypi }\n",
      "apps/api/pyproject.toml": "[project]\nname = \"acme-api\"\nversion = \"1.0.0\"\n[build-system]\nrequires = [\"hatchling\"]\nbuild-backend = \"hatchling.build\"\n",
      "apps/worker/pyproject.toml": "[project]\nname = \"worker\"\nversion = \"0.3.0\"\ndependencies = [\"acme-api>=1.0.0\"]\n[build-system]\nrequires = [\"hatchling\"]\nbuild-backend = \"hatchling.build\"\n[tool.uv.sources]\nacme-api = { workspace = true }\n"
    },
    "steps": [
      {
        "args": [
          "order",
          "-o",
          "json"
        ],
        "expected": {
          "exitCode": 0,
          "payload": {
            "ok": true,
            "order": [
              {
                "key": "apps/api",
                "version": "1.0.0",
                "tag": "apps/api@1.0.0",
                "imports": [],
                "ecosystem": "pypi",
                "path": "apps/api",
                "destination": "https://pypi.org/simple/acme-api"
              },
              {
                "key": "apps/worker",
                "version": "0.3.0",
                "tag": "apps/worker@0.3.0",
                "imports": [
                  "apps/api"
                ],
                "ecosystem": "pypi",
                "path": "apps/worker",
                "destination": "https://pypi.org/simple/worker"
              }
            ]
          }
        }
      }
    ]
  },
  {
    "name": "pypi: a file reference not rooted at the project fails the plan",
    "files": {
      "telo-workspace.yaml": "release:\n  ecosystems: { pypi: { registry: https://pypi.org/simple } }\n  units:\n    - { path: apps/api, ecosystem: pypi }\n    - { path: apps/worker, ecosystem: pypi }\n",
      "apps/api/pyproject.toml": "[project]\nname = \"acme-api\"\nversion = \"1.0.0\"\n[build-system]\nrequires = [\"hatchling\"]\nbuild-backend = \"hatchling.build\"\n",
      "apps/worker/pyproject.toml": "[project]\nname = \"worker\"\nversion = \"0.3.0\"\ndependencies = [\"acme-api @ file:///srv/acme-api\"]\n[build-system]\nrequires = [\"hatchling\"]\nbuild-backend = \"hatchling.build\"\n"
    },
    "steps": [
      {
        "args": [
          "status",
          "--base",
          "HEAD",
          "-o",
          "json"
        ],
        "expected": {
          "exitCode": 1,
          "payload": {
            "ok": false
          }
        }
      }
    ]
  },
