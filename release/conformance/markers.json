  {
    "name": "anchors-invalid-and-claimed",
    "files": {
      "telo-workspace.yaml": "release:\n  units:\n    - { path: a, ecosystem: { npm: '*' } }\n    - { path: b, ecosystem: { npm: ../a } }\n    - { path: c, ecosystem: { cargo: rust } }\n    - { path: '.', ecosystem: { npm: shared }, version: VERSION }\n    - { path: shared, ecosystem: npm }\n    - { path: e, ecosystem: { npm: [x, x, 3] } }\n    - { path: f, ecosystem: { payload: '.' } }\n",
      "VERSION": "1.0.0\n",
      "c/rust/README.md": "\n",
      "shared/package.json": "{\n  \"name\": \"shared\",\n  \"version\": \"1.0.0\"\n}\n"
    },
    "expected": {
      "diagnostics": [
        {
          "code": "WORKSPACE_ANCHOR_INVALID",
          "severity": "error",
          "message": "telo-workspace.yaml: anchor \"*\" of 'npm' is not a literal directory inside the unit. An anchor is a unit-relative path with no pattern and no '..' (or '.' for the unit itself).",
          "path": [
            "release",
            "units",
            0,
            "ecosystem",
            "npm"
          ]
        },
        {
          "code": "WORKSPACE_UNIT_VERSION_UNRESOLVED",
          "severity": "error",
          "message": "telo-workspace.yaml: 'release.units.0' (a) declares no 'version:' and none of its ecosystems (npm) keeps a version. Declare 'version:', naming the file that holds it.",
          "path": [
            "release",
            "units",
            0
          ]
        },
        {
          "code": "WORKSPACE_ANCHOR_INVALID",
          "severity": "error",
          "message": "telo-workspace.yaml: anchor \"../a\" of 'npm' is not a literal directory inside the unit. An anchor is a unit-relative path with no pattern and no '..' (or '.' for the unit itself).",
