# The extension ships as one esbuild bundle (`dist/extension.js`) plus the
# bundled telo engine (`dist/engine/language-server.mjs`), so
# nothing that produced it needs to travel with it.
.vscodeignore
.gitignore
src/**
tests/**
vitest.config.mts
scripts/**
node_modules/**
tsconfig.json
esbuild.mjs
**/*.ts
**/*.map
*.vsix
