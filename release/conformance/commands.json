  {
    "name": "an image built from the workspace root plans nothing after its own apply",
    "files": {
      "telo-workspace.yaml": "release:\n  ecosystems: { docker: { registry: ghcr.io/acme } }\n  units:\n    - path: app\n      version: VERSION\n      ecosystem: { docker: { \".\": { context: . } } }\n",
      "app/VERSION": "1.0.0\n",
      "app/Dockerfile": "FROM scratch\nCOPY . /src\n",
      ".changes/pending/fixed-a-fix.yaml": "units: { app: Fixed }\nbody: A fix.\n"
    },
    "steps": [
      {
        "args": [
          "apply",
          "--base",
          "HEAD",
          "--date",
          "2026-01-02"
        ],
        "expected": {
          "exitCode": 0,
          "payload": {
            "ok": true,
            "units": [
              {
                "key": "app",
                "name": "app",
                "from": "1.0.0",
                "to": "1.0.1",
                "tag": "app@1.0.1",
                "level": "patch",
                "reasons": [
                  "declared"
                ],
                "changedLayers": [],
                "entries": [
                  {
                    "kind": "Fixed",
                    "body": "A fix."
                  }
                ]
              }
            ],
            "fragments": [
              ".changes/pending/fixed-a-fix.yaml"
            ],
            "diagnostics": [],
            "written": [
              "app/VERSION",
              "app/CHANGELOG.md",
              ".changes/ledger.yaml",
              ".changes/pending/fixed-a-fix.yaml"
            ]
          }
        }
      },
      {
        "args": [
          "status",
          "--base",
          "HEAD"
        ],
        "expected": {
          "exitCode": 0,
          "payload": {
            "ok": true,
            "units": [],
            "fragments": [],
            "diagnostics": []
          }
        }
      }
    ]
  },
