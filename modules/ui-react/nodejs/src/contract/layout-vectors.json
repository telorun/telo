                  "aria-label": "Oct 7"
                }
              }
            }
          },
          {
            "click": {
              "part": "menu-item",
              "text": "Oct 10"
            }
          },
          {
            "expect": {
              "intents": [
                [
                  "onMove",
                  "1",
                  {
                    "startsOn": "2026-10-10",
                    "endsOn": "2026-10-11"
                  }
                ]
              ]
            }
          }
        ]
      }
    ]
