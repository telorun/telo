{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://telo.run/schemas/editor-protocol.json",
  "title": "Telo editor protocol, generation 2",
  "description": "The messages an editor host and a telo language-server engine exchange beyond LSP itself. Each request — host-served (engine to host) or engine-served (host to engine) — has a `<Name>Params` and a `<Name>Result` definition; `RequirementsParams` and `ViewModelChangedParams` are the engine-to-host `telo/requirements` and `telo/viewModelChanged` notifications; `TeloDiagnosticData` is what an engine puts in `Diagnostic.data`; `ExperimentalCapabilities` is what an engine advertises under `ServerCapabilities.experimental`. `x-telo-methods` maps each method name to its definitions. Objects are open and enumerations list the values known to this generation: a receiver ignores a member it does not know and reads an unknown enumeration value as its least-capable value (README.md, Generations). See README.md for the handshake and the generation rule.",
  "x-telo-methods": {
    "telo/read": {
      "params": "#/$defs/ReadParams",
      "result": "#/$defs/ReadResult"
    },
    "telo/exists": {
      "params": "#/$defs/ExistsParams",
      "result": "#/$defs/ExistsResult"
    },
    "telo/listDirectory": {
      "params": "#/$defs/ListDirectoryParams",
      "result": "#/$defs/ListDirectoryResult"
    },
    "telo/hub/searchRefs": {
      "params": "#/$defs/SearchRefsParams",
      "result": "#/$defs/SearchRefsResult"
    },
    "telo/hub/listVersions": {
      "params": "#/$defs/ListVersionsParams",
      "result": "#/$defs/ListVersionsResult"
    },
    "telo/requirements": {
      "params": "#/$defs/RequirementsParams"
    },
    "telo/viewModel": {
      "params": "#/$defs/ViewModelParams",
      "result": "#/$defs/ViewModelResult"
    },
    "telo/celCompletion": {
      "params": "#/$defs/CelCompletionParams",
      "result": "#/$defs/CelCompletionResult"
    },
    "telo/viewModelChanged": {
      "params": "#/$defs/ViewModelChangedParams"
    }
  },
  "$defs": {
    "ExperimentalCapabilities": {
      "type": "object",
      "required": [
        "telo"
      ],
      "properties": {
        "telo": {
          "type": "object",
          "required": [
            "protocol"
          ],
          "properties": {
            "protocol": {
              "type": "integer",
              "minimum": 1,
              "description": "The protocol generation the engine speaks."
            },
            "viewModel": {
              "type": "boolean",
              "description": "The engine serves `telo/viewModel` and `telo/celCompletion` and sends `telo/viewModelChanged`."
            }
          }
        }
      }
    },
    "ReadParams": {
      "type": "object",
      "required": [
        "uri"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "description": "A document URI (`file:///…`) or an import source (`oci://…`, `https://…`)."
        }
      }
    },
    "ReadResult": {
      "description": "The text and the canonical location it was read from (a directory resolves to its `telo.yaml`), or null when nothing exists at the URI.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "uri",
            "text"
          ],
          "properties": {
            "uri": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "ExistsParams": {
      "type": "object",
      "required": [
        "base",
        "relative"
      ],
      "properties": {
        "base": {
          "type": "string",
          "description": "URI of a file; `relative` resolves against its directory."
        },
        "relative": {
          "type": "string"
        }
      }
    },
    "ExistsResult": {
      "type": "boolean"
    },
    "ListDirectoryParams": {
      "type": "object",
      "required": [
        "uri"
      ],
      "properties": {
        "uri": {
          "type": "string"
        }
      }
    },
    "DirectoryEntry": {
      "type": "object",
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "description": "What the entry is, read without following a link: a symbolic link is `symlink` whatever it points at. A receiver reads a kind it does not know as `other`.",
          "anyOf": [
            {
              "enum": [
                "file",
                "directory",
                "symlink",
                "other"
              ]
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "ListDirectoryResult": {
      "description": "The entries, or null when the URI names nothing or names a file.",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DirectoryEntry"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "SearchRefsParams": {
      "type": "object",
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string"
        }
      }
    },
    "HubRef": {
      "type": "object",
      "required": [
        "ref",
        "latestVersion"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "latestVersion": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "SearchRefsResult": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HubRef"
      }
    },
    "ListVersionsParams": {
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string"
        }
      }
    },
    "ModuleVersion": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha256-[A-Za-z0-9_-]{43}$",
          "description": "Canonical import pin: `sha256-` and 43 base64url characters."
        }
      }
    },
    "ListVersionsResult": {
      "description": "Newest first; empty for a ref the hub does not track.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ModuleVersion"
      }
    },
    "VersionBound": {
      "type": "object",
      "required": [
        "version",
        "inclusive"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "inclusive": {
          "type": "boolean"
        }
      }
    },
    "VersionInterval": {
      "description": "A `requires: telo:` range reduced to its edges; an absent edge is open.",
      "type": "object",
      "properties": {
        "min": {
          "$ref": "#/$defs/VersionBound"
        },
        "max": {
          "$ref": "#/$defs/VersionBound"
        }
      }
    },
    "RequirementsRange": {
      "type": "object",
      "required": [
        "module",
        "text",
        "interval"
      ],
      "properties": {
        "module": {
          "type": "string",
          "description": "URI of the module document declaring the range."
        },
        "text": {
          "type": "string",
          "description": "The range as written."
        },
        "interval": {
          "$ref": "#/$defs/VersionInterval"
        }
      }
    },
    "RequirementsParams": {
      "type": "object",
      "required": [
        "owner",
        "documents",
        "ranges"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ranges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequirementsRange"
          }
        }
      }
    },
    "ViewModelChangedParams": {
      "description": "Sent after each analysis of an owner module, and when the owner stops being analysed.",
      "type": "object",
      "required": [
        "owner",
        "revision"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "description": "Canonical `file:` URI of the owner module's document."
        },
        "revision": {
          "type": "integer",
          "description": "Increases with every analysis of the owner, and when it is dropped."
        }
      }
    },
    "ViewModelParams": {
      "type": "object",
      "required": [
        "owner"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "configuration": {
          "description": "The assignment to draw the module graph in; a dimension left out takes its default.",
          "type": "object"
        }
      }
    },
    "ViewModelResult": {
      "description": "The owner's view model, or null when the engine is not analysing it.",
      "oneOf": [
        {
          "$ref": "#/$defs/ViewModel"
        },
        {
          "type": "null"
        }
      ]
    },
    "CelCompletionParams": {
      "type": "object",
      "required": [
        "owner",
        "resource",
        "path",
        "tag",
        "text",
        "offset"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "resource": {
          "description": "The resource the field belongs to.",
          "type": "object",
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "path": {
          "type": "string",
          "description": "Concrete path of the field within the resource."
        },
        "tag": {
          "type": "string",
          "description": "The tag the value is written under, without its `!`."
        },
        "text": {
          "type": "string",
          "description": "The field's value without its tag."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Cursor offset into `text`."
        }
      }
    },
    "CelCompletionResult": {
      "description": "Completion items; a `textEdit` range is a line/character range in the request's `text`.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/CompletionItem"
      }
    },
    "CompletionItem": {
      "description": "The members of an LSP `CompletionItem` an engine sets.",
      "type": "object",
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "integer",
          "description": "LSP `CompletionItemKind`."
        },
        "detail": {
          "type": "string"
        },
        "documentation": {
          "type": "string"
        },
        "insertText": {
          "type": "string"
        },
        "insertTextFormat": {
          "type": "integer",
          "description": "LSP `InsertTextFormat`; 2 is a snippet."
        },
        "textEdit": {
          "type": "object",
          "required": [
            "range",
            "newText"
          ],
          "properties": {
            "range": {
              "type": "object",
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "object",
                  "required": [
                    "line",
                    "character"
                  ],
                  "properties": {
                    "line": {
                      "type": "integer"
                    },
                    "character": {
                      "type": "integer"
                    }
                  }
                },
                "end": {
                  "type": "object",
                  "required": [
                    "line",
                    "character"
                  ],
                  "properties": {
                    "line": {
                      "type": "integer"
                    },
                    "character": {
                      "type": "integer"
                    }
                  }
                }
              }
            },
            "newText": {
              "type": "string"
            }
          }
        },
        "preselect": {
          "type": "boolean"
        },
        "sortText": {
          "type": "string"
        },
        "filterText": {
          "type": "string"
        },
        "command": {
          "type": "object",
          "required": [
            "title",
            "command"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "command": {
              "type": "string"
            }
          }
        }
      }
    },
    "ViewModel": {
      "description": "What a structured editor reads about one owner module, from the analysis its diagnostics come from.",
      "type": "object",
      "required": [
        "owner",
        "revision",
        "moduleGraph",
        "moduleRootSchema",
        "kindSpellings",
        "refConstraints",
        "contracts",
        "outputRefusals",
        "templates",
        "referenceSites",
        "documents"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "moduleGraph": {
          "oneOf": [
            {
              "$ref": "#/$defs/ModuleGraphData"
            },
            {
              "type": "null"
            }
          ]
        },
        "moduleRootSchema": {
          "description": "The schema of the owner's module document kind.",
          "oneOf": [
            {
              "type": "object",
              "description": "A JSON Schema, as plain JSON."
            },
            {
              "type": "null"
            }
          ]
        },
        "kindSpellings": {
          "description": "Kind spelling → the canonical kind it resolves to; an unresolved spelling is absent.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "refConstraints": {
          "description": "Reference-slot constraint → what satisfies it; an unresolved constraint is absent.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/RefConstraint"
          }
        },
        "contracts": {
          "description": "Canonical kind → its invocation contract, for every kind declaring one.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/KindContract"
          }
        },
        "outputRefusals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OutputRefusals"
          }
        },
        "templates": {
          "description": "Canonical kind → the body of the templated kind.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/TemplateGraphData"
          }
        },
        "referenceSites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReferenceSite"
          }
        },
        "documents": {
          "description": "Canonical URI → the LSP version of each open document the analysis read.",
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "configurations": {
          "$ref": "#/$defs/ViewModelConfigurations"
        }
      }
    },
    "RefConstraint": {
      "type": "object",
      "required": [
        "accepted",
        "userFacing"
      ],
      "properties": {
        "accepted": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Canonical kinds that satisfy the constraint, sorted."
        },
        "userFacing": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Alias-form kinds a new resource could be created with."
        }
      }
    },
    "KindContract": {
      "type": "object",
      "properties": {
        "inputType": {
          "type": "object",
          "description": "A JSON Schema, as plain JSON."
        },
        "outputType": {
          "type": "object",
          "description": "A JSON Schema, as plain JSON."
        }
      }
    },
    "OutputRefusals": {
      "description": "One reference slot declaring an `outputType`, and why each candidate cannot fill it.",
      "type": "object",
      "required": [
        "kind",
        "pointer",
        "refusals"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "The canonical kind declaring the slot."
        },
        "pointer": {
          "type": "string",
          "description": "JSON Pointer of the slot's `x-telo-ref` node within that kind's `schema`."
        },
        "refusals": {
          "description": "Resource name, in the scope the entry is listed in, → one line per definite mismatch; an absent resource can fill the slot.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "TemplateGraphData": {
      "type": "object",
      "required": [
        "kindId",
        "name",
        "definition",
        "graph",
        "outputRefusals"
      ],
      "properties": {
        "kindId": {
          "type": "string",
          "description": "Canonical `<module>.<Name>`."
        },
        "name": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "capability": {
          "type": "string",
          "description": "The kind's capability, inherited along `extends`."
        },
        "definition": {
          "type": "object",
          "description": "The definition document as analysed; its `metadata.source` is a document URI."
        },
        "graph": {
          "$ref": "#/$defs/ModuleGraphData"
        },
        "outputRefusals": {
          "description": "Per reference slot declaring an `outputType`, why each entry of the body cannot fill it, keyed by entry name.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/OutputRefusals"
          }
        }
      }
    },
    "ReferenceSite": {
      "type": "object",
      "required": [
        "source",
        "path",
        "target"
      ],
      "properties": {
        "source": {
          "description": "The resource writing the reference.",
          "type": "object",
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "path": {
          "type": "string",
          "description": "Concrete path of the slot within that resource."
        },
        "target": {
          "type": "string",
          "description": "The name the reference holds, as written."
        }
      }
    },
    "ModuleGraphData": {
      "type": "object",
      "required": [
        "nodes",
        "edges",
        "regions",
        "kinds"
      ],
      "properties": {
        "root": {
          "$ref": "#/$defs/GraphNode"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GraphNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GraphEdge"
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GraphRegion"
          }
        },
        "kinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GraphKind"
          }
        }
      }
    },
    "GraphNode": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "ownership",
        "ports",
        "rows",
        "rowArrays"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "description": "The kind as written."
        },
        "name": {
          "type": "string"
        },
        "capability": {
          "type": "string"
        },
        "canonicalKind": {
          "type": "string",
          "description": "The canonical kind, when `kind` is not already canonical."
        },
        "unknownKind": {
          "type": "boolean"
        },
        "ownership": {
          "anyOf": [
            {
              "enum": [
                "root",
                "named",
                "inline",
                "scoped",
                "imported",
                "injected",
                "enclosing",
                "forwarded"
              ]
            },
            {
              "type": "string"
            }
          ]
        },
        "owner": {
          "type": "string",
          "description": "Node owning this declaration (`inline`, `scoped`)."
        },
        "ownerSite": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "external": {
          "type": "boolean"
        },
        "alias": {
          "type": "string"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GraphPort"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GraphRow"
          }
        },
        "rowArrays": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "kind"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "kind": {
                "anyOf": [
                  {
                    "enum": [
                      "step",
                      "entry",
                      "target",
                      "inline",
                      "reference",
                      "export"
                    ]
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            }
          }
        },
        "throws": {
          "type": "object",
          "required": [
            "codes",
            "unbounded"
          ],
          "properties": {
            "codes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unbounded": {
              "type": "boolean"
            }
          }
        },
        "root": {
          "type": "boolean"
        },
        "choice": {
          "$ref": "#/$defs/GraphChoice"
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GraphChoice"
          }
        },
        "family": {
          "$ref": "#/$defs/GraphRepeat"
        }
      }
    },
    "GraphPort": {
      "type": "object",
      "required": [
        "slot",
        "refs",
        "capabilities",
        "array",
        "class",
        "slots"
      ],
      "properties": {
        "slot": {
          "type": "string",
          "description": "Field-map path with `[]` / `{}` markers."
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "array": {
          "type": "boolean"
        },
        "class": {
          "anyOf": [
            {
              "enum": [
                "flow",
                "holds",
                "shape",
                "data"
              ]
            },
            {
              "type": "string"
            }
          ]
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "targetNode": {
                "type": "string"
              },
              "inline": {
                "type": "boolean"
              }
            }
          }
        },
        "addPath": {
          "type": "string"
        },
        "rowOwned": {
          "type": "boolean"
        }
      }
    },
    "GraphRow": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "path",
        "array",
        "index",
        "depth"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "step",
                "entry",
                "target",
                "repeat",
                "inline",
                "reference",
                "export"
              ]
            },
            {
              "type": "string"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
