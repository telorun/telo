# `.docusaurus` is the default generated dir; `.docusaurus-docker` is the one the
# compose `pages` service uses so container and host builds don't clobber each
# other's absolute paths (see docker-compose.yml).
.docusaurus*
build

# Generated by the llms-txt plugin on every dev start / build.
static/llms.txt
static/llms-full.txt
static/.llms-txt-generated.json
static/**/*.md

# Copied from the repository root by `scripts/copy-installers.mjs` so the site
# serves them; the scripts themselves live at the root.
static/install.sh
static/install.ps1
