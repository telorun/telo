    "name": "flat-and-unknown-keys",
    "files": {
      "telo-workspace.yaml": "release:\n  modules: [modules/*]\n  registry: oci://x\n  unit: []\n  units:\n    - { path: a, ecosystem: npm, registry: ghcr.io/acme }\n    - { path: b, ecosystem: docker, version: V, context: . }\n    - { path: c, ecosystem: npm, verison: package.json }\n    - { path: d, ecosystem: npm, frobnicate: 1 }\n",
      "a/package.json": "{\n  \"name\": \"a\",\n  \"version\": \"1.0.0\"\n}\n",
      "b/V": "1.0.0\n",
      "b/Dockerfile": "FROM scratch\n",
      "c/package.json": "{\n  \"name\": \"c\",\n  \"version\": \"1.0.0\"\n}\n",
      "d/package.json": "{\n  \"name\": \"d\",\n  \"version\": \"1.0.0\"\n}\n"
    },
    "expected": {
      "diagnostics": [
        {
          "code": "WORKSPACE_MODULES_MOVED",
          "severity": "error",
          "message": "telo-workspace.yaml: 'release.modules' became 'release.units': list each unit with the ecosystem it ships through, e.g. { path: modules/*, ecosystem: telo }.",
          "path": [
            "release",
            "modules"
          ]
        },
        {
          "code": "WORKSPACE_MODULES_MOVED",
          "severity": "error",
          "message": "telo-workspace.yaml: 'release.registry' moved under 'release.ecosystems', keyed by the ecosystem reading it, e.g. ecosystems: { telo: { registry: oci://ghcr.io/acme } }.",
          "path": [
            "release",
            "registry"
          ]
        },
        {
          "code": "WORKSPACE_UNKNOWN_KEY",
          "severity": "error",
          "message": "telo-workspace.yaml: unknown key 'release.unit'. Did you mean 'units'?",
          "path": [
            "release",
            "unit"
          ]
        },
        {
          "code": "WORKSPACE_UNKNOWN_KEY",
          "severity": "error",
          "message": "telo-workspace.yaml: 'release.units.0.registry' is a setting of the docker / helm ecosystem, which is never written flat on an entry. Write it at the anchor (ecosystem: { docker: { \".\": { registry: … } } }) or for every docker anchor under 'release.ecosystems.docker'.",
          "path": [
            "release",
            "units",
            0,
            "registry"
