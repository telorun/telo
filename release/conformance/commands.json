  {
    "name": "baseline records every unit with no entry once, reports a candidate, and refuses to overwrite an entry",
    "files": {
      "app/VERSION": "1.0.0\n",
      "app/Dockerfile": "FROM scratch\n",
      "lib/VERSION": "0.3.0\n",
      "lib/index.txt": "lib\n",
      "telo-workspace.yaml": "release:\n  ecosystems: { docker: { registry: ghcr.io/acme } }\n  units:\n    - path: app\n      version: VERSION\n      ecosystem: { docker: { \".\": {} } }\n    - { path: lib, version: VERSION, payload: [\"**\"] }\n    - { path: cand, version: VERSION, payload: [\"**\"] }\n",
      "cand/VERSION": "2.0.0-rc.1\n",
      "cand/a.txt": "a\n"
    },
    "steps": [
      {
        "args": [
          "baseline",
          "--dry-run"
        ],
        "expected": {
          "exitCode": 0,
          "payload": {
            "ok": true,
            "recorded": [
              {
                "key": "app",
                "version": "1.0.0"
              },
              {
                "key": "lib",
                "version": "0.3.0"
              }
            ],
            "skipped": [],
            "unrecorded": [
              {
                "key": "cand",
                "reason": "it carries the candidate version 2.0.0-rc.1; baseline records final versions only"
              }
            ],
            "dryRun": true
          }
        }
      },
      {
        "args": [
          "baseline",
          "--dry-run"
        ],
        "expected": {
          "exitCode": 0,
          "payload": {
            "ok": true,
            "recorded": [
              {
                "key": "app",
                "version": "1.0.0"
              },
              {
                "key": "lib",
                "version": "0.3.0"
              }
            ],
            "skipped": [],
            "unrecorded": [
              {
                "key": "cand",
                "reason": "it carries the candidate version 2.0.0-rc.1; baseline records final versions only"
              }
            ],
            "dryRun": true
          }
        }
