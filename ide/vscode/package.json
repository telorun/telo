{
  "name": "telo-vscode",
  "displayName": "Telo",
  "version": "0.4.0",
  "private": true,
  "description": "Diagnostics, completions and refactorings for Telo manifests, from the telo version each module is edited against",
  "keywords": [
    "telo",
    "vscode",
    "yaml",
    "diagnostics"
  ],
  "author": "Bartosz Pasiński <bartosz.pasinski@codenet.pl>",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telorun/telo.git",
    "directory": "ide/vscode"
  },
  "homepage": "https://github.com/telorun/telo#readme",
  "bugs": {
    "url": "https://github.com/telorun/telo/issues"
  },
  "publisher": "telorun",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "telo",
        "aliases": [
          "Telo",
          "telo"
        ],
        "filenamePatterns": [
          "telo.yaml",
          "*.telo.yaml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "telo",
        "scopeName": "source.telo",
        "path": "./syntaxes/telo.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "telo.upgradeImport",
        "title": "Upgrade Import",
        "category": "Telo"
      },
      {
        "command": "telo.upgradeAllImports",
        "title": "Upgrade All Imports",
        "category": "Telo"
      },
      {
        "command": "telo.refreshImportUpgrades",
        "title": "Check Imports for Updates",
        "category": "Telo"
      },
      {
        "command": "telo.selectVersion",
        "title": "Select Telo Version",
        "category": "Telo"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "telo.upgradeImport",
          "when": "false"
        },
        {
          "command": "telo.upgradeAllImports",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Telo",
      "properties": {
        "telo.version": {
          "type": "string",
          "default": "auto",
          "pattern": "^(auto|(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?)$",
          "markdownDescription": "The telo version manifests are edited against: `auto` picks one per module from its `requires: telo:` and its imports' ranges, or an exact engine identity pins every module to it — a published version (`0.102.0`), or a development build's (`0.102.0+unreleased`). Run **Telo: Select Telo Version** to choose from the versions available."
        },
        "telo.importUpgrades.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLenses over `imports:` when a module has a newer version on the hub. Disable to stop the editor contacting the hub for version lists."
        },
        "telo.hubUrl": {
          "type": "string",
          "default": "https://telo.sh",
          "description": "Base URL of the Telo hub used for federated import-source autocomplete (ref search and version lists)."
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm --filter \"telo-vscode^...\" build && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vsix": "pnpm run build && node scripts/stage-license.mjs && vsce package --no-dependencies --out telo-vscode.vsix",
    "test": "vitest run"
  },
  "dependencies": {
    "@telorun/editor-protocol": "workspace:*",
    "@telorun/kernel": "workspace:*",
    "@telorun/language-host": "workspace:*",
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@telorun/language-server": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/vscode": "~1.91.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.27.4",
    "ovsx": "^1.0.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8",
    "vscode-languageserver-protocol": "3.18.4"
  }
}
