      },
      "record": {
        "description": "A log record or a span record, as the sink's own contract declares."
      }
    },
    "required": [
      "instance",
      "record"
    ],
    "additionalProperties": false
  },
  "response": null,
  "errors": [],
  "synchronous": false,
  "reentrant": false
}
