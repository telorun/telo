{
  "name": "@telorun/ui-react-build",
  "version": "0.12.0",
  "license": "MIT",
  "private": true,
  "description": "Build-only package for the std/ui-react module: its bundled controller and the browser entries it serves. Never published — the controller ships inside the module artifact as a pkg:telo/local/js bundle and the browser entries in its browser layer. This package exists to declare the dependencies esbuild inlines and to TYPE-CHECK the source, which esbuild does not do.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && tsc -p tsconfig.spec.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@floating-ui/react-dom": "2.1.8",
    "@tanstack/react-virtual": "3.14.26",
    "@telorun/message-format": "workspace:*",
    "@telorun/sse-codec": "workspace:*",
    "@telorun/ui": "workspace:*",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.8.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-autolink-literal": "^2.0.1",
    "mdast-util-gfm-strikethrough": "^2.0.0",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "micromark-extension-gfm-autolink-literal": "^2.1.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "micromark-extension-gfm-task-list-item": "^2.1.0"
  },
  "devDependencies": {
    "@telorun/cel": "workspace:*",
    "@telorun/http-dispatch": "workspace:*",
    "@telorun/sdk": "workspace:*",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "catalog:",
    "fastify": "^5.12.1",
    "happy-dom": "catalog:",
    "jsdom": "^25.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^5.0.0",
    "vitest": "^2.1.8",
    "yaml": "^2.8.3"
  }
}
