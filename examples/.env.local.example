# Local environment template for examples in this directory.
#
# Copy this file to `.env.local` (which is git-ignored) and fill in real
# values. The CLI auto-loads `.env.local` from the manifest's directory
# when you run `telo …`, so any keys here become `env.<NAME>` inside the
# manifest's root-module `compile` scope (and feed `variables`/`secrets`
# bound to these env keys).
#
# Every other example runs with no configuration at all — anything they read
# has a default in the manifest.

# agent-console, chat-console, ai-image-console, draw-shapes-agent
OPENAI_API_KEY=sk-...

# draw-shapes-agent also needs an S3-compatible store (MinIO works)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=telo-draw
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
