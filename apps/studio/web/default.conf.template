# The web build of Telo Studio, served as static files. Telo Cloud's ingress
# puts this behind `studio.telo.run` and routes `/api` to the Cloud API itself,
# so nothing here proxies: a request for `/api/...` that reaches this server
# means Cloud is not in front of it, and it answers 404 so Studio reads the
# origin as one without Cloud.
#
# A template: the image's entrypoint writes it to /etc/nginx/conf.d/default.conf
# at start, substituting ONLY `ACCOUNTS_URL` (NGINX_ENVSUBST_FILTER in the
# Dockerfile), so nginx's own variables stay as written.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # `add_header` in a location REPLACES the server's set, so every location
    # includes the same file rather than inheriting.
    include /etc/nginx/snippets/security-headers.conf;

    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        return 404;
    }

    # Runtime configuration: one image serves every environment.
    location = /config.json {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        default_type application/json;
        return 200 '{"accountsUrl":"${ACCOUNTS_URL}"}';
    }

    # Content-hashed by the build: the name changes when the bytes do.
    location ~ ^/(assets|engine)/ {
        include /etc/nginx/snippets/security-headers.conf;
        # Without `always`: a 404 for a name that does not exist yet must not be
        # cached as immutable.
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Single-page fallback: any other path is the app's to route.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
