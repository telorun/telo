{
  "description": "How an address or request target resolves to the text a renderer follows or requests, one row per case. `address` is the wire form `ui` produces; `roots` is what a chain reads from; a row has `url` for the text it resolves to, or `unresolved` for the parameter named by the error (`ERR_UI_ADDRESS_UNRESOLVED`, `data.parameter`). Held by every renderer's expansion.",
  "rows": [
    {
      "name": "a literal path is used as written",
      "address": {
        "path": {
          "value": "/docs"
        },
        "pathParams": {},
        "queryParams": {}
      },
      "url": "/docs"
    },
    {
      "name": "an absolute address is used as written",
      "address": {
        "path": {
          "value": "https://example.com/a?b=1#c"
        },
        "pathParams": {},
        "queryParams": {}
      },
      "url": "https://example.com/a?b=1#c"
    },
    {
      "name": "a variable segment is filled with a string",
      "address": {
        "path": {
          "value": "/items/{id}"
        },
        "pathParams": {
          "id": {
            "value": "abc"
          }
        },
        "queryParams": {}
      },
      "url": "/items/abc"
    },
    {
      "name": "an integer is written as decimal",
      "address": {
        "path": {
          "value": "/items/{id}"
        },
        "pathParams": {
          "id": {
            "value": 7
          }
        },
        "queryParams": {}
      },
      "url": "/items/7"
    },
    {
      "name": "a slash in a value is encoded",
      "address": {
        "path": {
          "value": "/items/{id}"
        },
        "pathParams": {
          "id": {
            "value": "a/b"
          }
        },
        "queryParams": {}
      },
      "url": "/items/a%2Fb"
    },
    {
      "name": "a value that is two dots is encoded so it cannot move the path",
      "address": {
        "path": {
          "value": "/items/{id}"
        },
        "pathParams": {
          "id": {
            "value": ".."
          }
        },
        "queryParams": {}
      },
      "url": "/items/%2E%2E"
    },
    {
      "name": "a value that is one dot is encoded",
      "address": {
        "path": {
          "value": "/items/{id}"
        },
        "pathParams": {
          "id": {
            "value": "."
          }
        },
        "queryParams": {}
      },
      "url": "/items/%2E"
    },
    {
      "name": "only unreserved characters stay",
      "address": {
        "path": {
          "value": "/items/{id}"
        },
        "pathParams": {
          "id": {
            "value": "a b~c-d_e.f!*'()?#é"
          }
        },
        "queryParams": {}
      },
      "url": "/items/a%20b~c-d_e.f%21%2A%27%28%29%3F%23%C3%A9"
    },
    {
      "name": "a name with dots inside keeps them",
      "address": {
        "path": {
          "value": "/items/{id}"
        },
        "pathParams": {
          "id": {
            "value": "v1.2..3"
          }
        },
        "queryParams": {}
      },
      "url": "/items/v1.2..3"
    },
    {
      "name": "several variables are filled in place",
      "address": {
        "path": {
          "value": "/o/{org}/r/{repo}"
        },
        "pathParams": {
          "org": {
            "value": "telo"
          },
          "repo": {
            "value": "run time"
          }
        },
        "queryParams": {}
      },
      "url": "/o/telo/r/run%20time"
    },
    {
      "name": "a variable after an absolute address's host is filled",
      "address": {
        "path": {
