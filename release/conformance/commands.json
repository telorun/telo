  {
    "name": "-o markdown writes the plan as a document, and refuses with an empty stdout what no stage fits",
    "files": {
      "telo-workspace.yaml": "release:\n  units:\n    - { path: lib, version: VERSION, payload: [VERSION] }\n    - { path: app, version: VERSION, payload: [VERSION] }\n  groups: { g: [lib, app] }\n",
      "lib/VERSION": "1.0.0\n",
      "app/VERSION": "2.0.0\n",
      ".changes/pending/added-a-feature.yaml": "units: { lib: Added }\nbody: |-\n  A feature, in two parts:\n\n  - the *first* one\n  - the `second` one\n"
    },
    "steps": [
      {
        "args": [
          "status",
          "--base",
          "HEAD",
          "-o",
          "markdown"
        ],
        "stdout": true,
        "expected": {
          "exitCode": 0,
