{
  "schema": {
    "type": "object",
    "properties": {
      "root": {
        "type": "string",
        "x-telo-type": {
          "name": "Telo.HostPath",
          "entry": "directory"
        }
      },
      "file": {
        "anyOf": [
          {
            "const": ":memory:"
          },
          {
            "type": "string",
            "x-telo-type": {
              "name": "Telo.HostPath",
              "entry": "file"
            }
          }
        ]
      },
      "roots": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Root"
        }
      },
      "anywhere": {
        "type": "string",
        "x-telo-type": "Telo.HostPath"
      },
      "icon": {
        "type": "string",
        "x-telo-type": {
          "name": "Telo.HostPath",
          "entry": "file",
          "mediaType": "image/png"
        }
      },
      "badge": {
        "type": "string",
        "x-telo-type": {
          "name": "Telo.HostPath",
          "mediaType": "image/png"
        }
      }
    },
    "$defs": {
      "Root": {
        "type": "string",
        "x-telo-type": {
          "name": "Telo.HostPath",
          "entry": "directory"
        }
      }
    }
  },
  "rows": [
    {
      "id": "entry/directory-slot-given-a-file",
      "value": {
        "root": "{file}"
      },
      "code": "ERR_HOST_PATH_ENTRY_MISMATCH",
      "message": "'/root' takes the path of a directory, but '{file}' is a file."
    },
    {
      "id": "entry/file-branch-of-a-union-given-a-directory",
      "value": {
        "file": "{directory}"
      },
      "code": "ERR_HOST_PATH_ENTRY_MISMATCH",
      "message": "'/file' takes the path of a file, but '{directory}' is a directory."
    },
    {
      "id": "entry/list-item-through-a-reference",
      "value": {
        "roots": [
          "{directory}",
          "{file}"
        ]
      },
      "code": "ERR_HOST_PATH_ENTRY_MISMATCH",
      "message": "'/roots/1' takes the path of a directory, but '{file}' is a file."
    },
    {
      "id": "entry/before-a-relative-path",
      "value": {
        "file": "data.db",
        "root": "{file}"
      },
      "code": "ERR_HOST_PATH_ENTRY_MISMATCH",
      "message": "'/root' takes the path of a directory, but '{file}' is a file."
    },
    {
      "id": "unreadable/a-path-the-filesystem-will-not-answer-for",
      "value": {
        "root": "{unreadable}"
      },
      "code": "ERR_HOST_PATH_UNREADABLE",
      "message": "'/root' takes the path of a directory, but what is at '{unreadable}' cannot be read ({reason})."
    },
    {
      "id": "entry/before-the-media-type",
      "value": {
        "icon": "{directory}"
      },
      "code": "ERR_HOST_PATH_ENTRY_MISMATCH",
      "message": "'/icon' takes the path of a file, but '{directory}' is a directory."
    },
    {
      "id": "content/png-slot-given-a-jpeg",
      "value": {
        "icon": "{jpeg}"
      },
      "code": "ERR_HOST_PATH_CONTENT_MISMATCH",
      "message": "icon: '{jpeg}' is image/jpeg; this slot takes image/png."
    },
    {
      "id": "content/png-slot-given-a-file-of-no-known-media-type",
      "value": {
        "icon": "{file}"
      },
      "code": "ERR_HOST_PATH_CONTENT_MISMATCH",
      "message": "icon: '{file}' carries no known media type's signature; this slot takes image/png."
    },
    {
      "id": "content/media-type-slot-given-a-directory",
      "value": {
        "badge": "{directory}"
      },
      "code": "ERR_HOST_PATH_CONTENT_MISMATCH",
      "message": "badge: '{directory}' is a directory; this slot takes image/png."
    },
    {
      "id": "relative/literal",
      "value": {
        "root": "data"
      },
      "code": "ERR_HOST_PATH_RELATIVE",
      "message": "'data' must be an absolute Telo.HostPath — a relative path names nothing fixed here. Write a file that ships with the module as !module-path <path>, or read a location on the host from a variable declared x-telo-type: Telo.HostPath, which resolves a relative value against the working directory."
    },
    {
      "id": "relative/union-branch",
      "value": {
        "file": "./app.db"
      },
      "code": "ERR_HOST_PATH_RELATIVE",
      "message": "'./app.db' must be an absolute Telo.HostPath — a relative path names nothing fixed here. Write a file that ships with the module as !module-path <path>, or read a location on the host from a variable declared x-telo-type: Telo.HostPath, which resolves a relative value against the working directory."
    },
    {
      "id": "accepted/matching-entries",
      "value": {
        "root": "{directory}",
        "file": "{file}",
        "roots": [
          "{directory}"
        ]
      },
      "code": null,
      "message": null
    },
    {
      "id": "accepted/absent-path",
      "value": {
        "root": "{absent}",
        "file": "{absent}"
      },
      "code": null,
      "message": null
    },
    {
      "id": "accepted/entry-unsaid",
      "value": {
        "anywhere": "{file}"
      },
      "code": null,
      "message": null
    },
    {
      "id": "accepted/union-constant",
      "value": {
        "file": ":memory:"
      },
      "code": null,
      "message": null
    },
    {
      "id": "accepted/matching-media-type",
      "value": {
        "icon": "{png}",
        "badge": "{png}"
      },
      "code": null,
      "message": null
    },
    {
      "id": "accepted/absent-media-type-path",
      "value": {
        "icon": "{absent}",
        "badge": "{absent}"
      },
      "code": null,
      "message": null
    }
  ]
}
