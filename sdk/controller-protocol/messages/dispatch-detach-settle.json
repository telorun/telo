{
  "name": "Dispatch.DetachSettle",
  "direction": "controller-to-kernel",
  "spec": "6. Invocation",
  "request": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "The detached task ended. A failure is routed to the event bus — there is no caller to raise it to — and the drain stops waiting for this task either way.",
    "type": "object",
    "properties": {
      "instance": {
        "type": "string",
        "minLength": 1
      },
      "task": {
        "type": "string",
        "minLength": 1
      },
      "outcome": {
        "type": "string",
        "enum": [
          "ok",
          "failed"
        ]
      },
      "error": {
        "description": "Present when the outcome is failed.",
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "description": "Structured detail."
          },
          "displayMessage": {
            "description": "The text a person is shown for the failure, as its record; its values are `data`.",
            "type": "object",
            "properties": {
              "text": {
                "description": "The Message in its fragment spelling: a pattern, or a plural selection."
              },
              "context": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lang": {
                "type": "string",
                "minLength": 1
              },
              "computed": {
                "type": "boolean"
              }
            },
            "required": [
              "text",
              "context",
              "lang",
              "computed"
            ],
            "additionalProperties": false
          },
          "inputPointer": {
            "description": "An RFC 6901 pointer into the inputs of the dispatch that raised the failure, naming the input it is about.",
            "type": "string",
            "pattern": "^(/([^/~]|~[01])*)*$"
          },
          "location": {
            "description": "Where in a manifest the failure was caused: the resource whose declaration holds the offending value, its declaring module, and a pointer into that declaration. Attached by the kernel where the failure first left a dispatch, and carried unchanged after.",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "module": {
                "type": "string"
              },
              "pointer": {
                "type": "string",
                "pattern": "^(/([^/~]|~[01])*)*$"
              }
            },
            "required": [
              "kind",
              "name"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "instance",
      "task",
      "outcome"
    ],
    "additionalProperties": false
  },
  "response": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "Recorded.",
    "type": "object",
    "additionalProperties": false
  },
  "errors": [],
  "synchronous": false,
  "reentrant": false
}
