{
  "name": "Module.ControllerFile",
  "direction": "controller-to-kernel",
  "spec": "9. Host facilities",
  "request": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "Resolve a module-relative reference against the module that declares the controller running this resource — the file ships with the code asking for it, never with the module that declared the resource.",
    "type": "object",
    "properties": {
      "instance": {
        "type": "string",
        "minLength": 1
      },
      "relative": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "instance",
      "relative"
    ],
    "additionalProperties": false
  },
  "response": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "The absolute URI.",
    "type": "object",
    "properties": {
      "uri": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:"
      }
    },
    "required": [
      "uri"
    ],
    "additionalProperties": false
  },
  "errors": [
    "ERR_MODULE_FILES_UNAVAILABLE"
  ],
  "synchronous": false,
  "reentrant": false
}
