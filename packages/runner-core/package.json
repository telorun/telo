{
  "name": "@telorun/runner-core",
  "version": "0.24.0",
  "description": "Backend-neutral core for Telo runners: the /v1 session contract, the RunnerBackend interface, the session registry, SSE/byte ring buffers, and bundle handling. Shared by docker-runner and k8s-runner.",
  "keywords": [
    "telo",
    "runner"
  ],
  "author": "Bartosz Pasiński <bartosz.pasinski@codenet.pl>",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telorun/telo.git",
    "directory": "packages/runner-core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./container": {
      "import": "./dist/container-config.js",
      "types": "./dist/container-config.d.ts"
    },
    "./test-support": {
      "import": "./dist/supervisor/fake-supervisor.js",
      "types": "./dist/supervisor/fake-supervisor.d.ts"
    }
  },
  "files": [
    "dist/**",
    "src/**",
    "workspace-app/**"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:supervisor": "cargo build --release --locked -p telo-runner-supervisor"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/websocket": "^11.0.1",
    "@telorun/debug-wire": "workspace:*",
    "fastify": "^5.12.1",
    "jose": "^6.2.3",
    "pg": "^8.20.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.0.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.0.0",
    "vitest": "^2.1.8"
  }
}
