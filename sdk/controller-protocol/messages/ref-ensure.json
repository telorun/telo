{
  "name": "Ref.Ensure",
  "direction": "controller-to-kernel",
  "spec": "7. Resolution & schema",
  "request": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "Normalize a slot value to a reference, registering an inline definition into the declaring module's scope on the way — the inverse of Ref.Resolve, and a different failure from it.",
    "type": "object",
    "properties": {
      "instance": {
        "type": "string",
        "minLength": 1
      },
      "value": {
        "description": "The slot's value."
      },
      "resourceName": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      }
    },
    "required": [
      "instance",
      "value"
    ],
    "additionalProperties": false
  },
  "response": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "refIdentity": {
        "description": "Where an instance was declared: its kind, its name, and the declaration site.",
        "type": "object",
        "required": [
          "kind",
          "name"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "origin": {
            "type": "object",
            "properties": {
              "module": {
                "type": "string"
              },
              "pointer": {
                "type": "string",
                "pattern": "^(/([^/~]|~[01])*)*$"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "description": "The reference, now naming a resource the kernel knows.",
    "type": "object",
    "properties": {
      "ref": {
        "$ref": "#/definitions/refIdentity"
      }
    },
    "required": [
      "ref"
    ],
    "additionalProperties": false
  },
  "errors": [],
  "synchronous": false,
  "reentrant": false
}
