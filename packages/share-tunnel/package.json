{
  "name": "@telorun/share-tunnel",
  "version": "0.1.0",
  "description": "The Telo share tunnel: the protocol a shared local run speaks to a runner's relay, its vectors, and the client engine that forwards visitor requests to local ports.",
  "keywords": [
    "telo",
    "runner",
    "share",
    "tunnel",
    "protocol"
  ],
  "author": "Bartosz Pasiński <bartosz.pasinski@codenet.pl>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telorun/telo.git",
    "directory": "packages/share-tunnel"
  },
  "homepage": "https://github.com/telorun/telo#readme",
  "bugs": {
    "url": "https://github.com/telorun/telo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./specs/vectors/*.json": "./specs/vectors/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**",
    "specs/**"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "node ../../scripts/rewrite-pack-links.mjs .",
    "postpack": "node ../../scripts/rewrite-pack-links.mjs . --restore"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.0.0",
    "vitest": "^2.1.8"
  }
}
