[
  {
    "name": "npm-pattern-with-private",
    "files": {
      "telo-workspace.yaml": "release:\n  units:\n    - { path: packages/*, ecosystem: npm }\n",
      "packages/a/package.json": "{\n  \"name\": \"@fx/a\",\n  \"version\": \"1.0.0\"\n}\n",
      "packages/b/package.json": "{\n  \"name\": \"@fx/b\",\n  \"version\": \"2.0.0\",\n  \"private\": true\n}\n",
      "packages/c/README.md": "no package\n"
    },
    "expected": {
      "diagnostics": [
        {
          "code": "WORKSPACE_UNIT_PAYLOAD_EMPTY",
          "severity": "error",
          "message": "Unit 'packages/b' ships no layer: its packages (npm at .) publish nothing. List the ecosystem it ships through, declare 'payload:', or exclude it with '!packages/b'.",
          "path": [
            "release",
            "units",
            0
          ]
        }
      ],
      "units": [
        {
          "key": "packages/a",
          "dir": "packages/a",
          "anchors": [
            {
              "ecosystem": "npm",
              "anchor": ".",
              "dir": "packages/a",
              "name": "@fx/a",
              "contributesLayer": true,
              "versionFiles": [],
              "settings": {}
            }
          ],
          "version": "packages/a/package.json",
          "versionLocations": [
            "packages/a/package.json"
          ],
          "payload": null,
          "metafile": null,
          "ignore": [
            "**/tests/**",
            "**/docs/**",
            "**/plans/**",
            "**/README.md",
            "**/CHANGELOG.md"
          ],
          "maxBump": "major",
          "group": null
        }
      ]
    }
  },
