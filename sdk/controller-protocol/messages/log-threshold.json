{
  "name": "Log.Threshold",
  "direction": "kernel-to-controller",
  "spec": "9. Host facilities",
  "request": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "severity": {
        "description": "An OpenTelemetry severity number (kernel/specs/logging.md §5.1).",
        "type": "integer",
        "minimum": 1,
        "maximum": 24
      }
    },
    "description": "The effective severity threshold for a resource's logging scope, sent when the instance is created and whenever it moves. A controller answers `enabled` from this rather than asking, so building a record it would discard costs nothing and asking costs no round trip.",
    "type": "object",
    "properties": {
      "session": {
        "type": "string",
        "minLength": 1
      },
      "instance": {
        "type": "string",
        "minLength": 1
      },
      "severity": {
        "$ref": "#/definitions/severity"
      }
    },
    "required": [
      "session",
      "instance",
      "severity"
    ],
    "additionalProperties": false
  },
  "response": null,
  "errors": [],
  "synchronous": false,
  "reentrant": false
}
