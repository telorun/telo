    "vectors": [
      {
        "name": "draws an event on every day it spans, under the month's title",
        "steps": [
          {
            "expect": {
              "text": [
                {
                  "of": {
                    "part": "calendar-title"
                  },
                  "value": "October 2026"
                }
              ],
              "present": [
                {
                  "tag": "span",
                  "text": "Kick-off",
                  "within": {
                    "part": "calendar-event",
                    "within": {
                      "part": "calendar-day",
                      "attributes": {
                        "aria-label": "Oct 7"
                      }
                    }
                  }
                },
                {
                  "tag": "span",
                  "text": "Kick-off",
                  "within": {
                    "part": "calendar-event",
                    "within": {
                      "part": "calendar-day",
                      "attributes": {
                        "aria-label": "Oct 8"
                      }
                    }
                  }
                }
              ],
              "absent": [
                {
                  "part": "calendar-event",
                  "within": {
                    "part": "calendar-day",
                    "attributes": {
                      "aria-label": "Oct 9"
                    }
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "name": "asks for the next month, then for the week its first day is in",
        "steps": [
          {
            "click": {
              "part": "calendar-next"
            }
          },
          {
            "expect": {
              "intents": [
                [
                  "onPeriodChange",
                  {
                    "from": "2026-11-01",
                    "to": "2026-11-30"
                  }
                ]
              ],
              "text": [
                {
                  "of": {
                    "part": "calendar-title"
                  },
                  "value": "November 2026"
                }
              ]
            }
          },
          {
            "click": {
              "part": "calendar-period",
              "text": "week"
            }
          },
          {
            "expect": {
              "intents": [
                [
                  "onPeriodChange",
                  {
                    "from": "2026-10-26",
                    "to": "2026-11-01"
                  }
                ]
              ]
            }
          }
        ]
      },
      {
        "name": "reschedules an event through its Move to menu, its end moved by as many days",
        "steps": [
          {
            "click": {
              "part": "record-move",
