{
  "name": "@telorun/hub-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telo Hub discovery frontend — a request-time React Router server that renders module pages, the sitemap and robots.txt from the live hub.",
  "keywords": [
    "telo",
    "hub",
    "discovery",
    "registration"
  ],
  "author": "Bartosz Pasiński <bartosz.pasinski@codenet.pl>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telorun/telo.git",
    "directory": "apps/hub-web"
  },
  "homepage": "https://github.com/telorun/telo#readme",
  "bugs": {
    "url": "https://github.com/telorun/telo/issues"
  },
  "scripts": {
    "dev": "node server.mjs",
    "build": "react-router typegen && tsc --noEmit && react-router build",
    "start": "NODE_ENV=production node server.mjs",
    "test": "pnpm run build && node --test \"test/**/*.test.mjs\"",
    "lint": "eslint"
  },
  "dependencies": {
    "@react-router/node": "7.18.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "7.18.4",
    "sirv": "^3.0.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6"
  }
}
