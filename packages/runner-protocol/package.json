{
  "name": "@telorun/runner-protocol",
  "version": "0.1.0",
  "description": "The Telo runner protocol: the client-facing /v1 contract of a runner — sessions, events, capabilities, errors and shares — as a normative README, a JSON Schema and TypeScript types.",
  "keywords": [
    "telo",
    "runner",
    "protocol"
  ],
  "author": "Bartosz Pasiński <bartosz.pasinski@codenet.pl>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telorun/telo.git",
    "directory": "packages/runner-protocol"
  },
  "homepage": "https://github.com/telorun/telo#readme",
  "bugs": {
    "url": "https://github.com/telorun/telo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runner-protocol-schema.json": "./runner-protocol-schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**",
    "runner-protocol-schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "prepack": "node ../../scripts/rewrite-pack-links.mjs .",
    "postpack": "node ../../scripts/rewrite-pack-links.mjs . --restore"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "typescript": "^5.0.0",
    "vitest": "^2.1.8"
  }
}
