{
  "name": "@telorun/image",
  "version": "0.10.0",
  "description": "Image primitives — draw labelled rectangles onto an image for vision-grounding loops.",
  "keywords": [
    "telo",
    "image",
    "overlay",
    "annotation"
  ],
  "author": "Bartosz Pasiński <bartosz.pasinski@codenet.pl>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telorun/telo.git",
    "directory": "modules/image/nodejs"
  },
  "homepage": "https://github.com/telorun/telo#readme",
  "bugs": {
    "url": "https://github.com/telorun/telo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./blank": {
      "types": "./dist/blank-controller.d.ts",
      "bun": "./src/blank-controller.ts",
      "import": "./dist/blank-controller.js"
    },
    "./overlay": {
      "types": "./dist/overlay-controller.d.ts",
      "bun": "./src/overlay-controller.ts",
      "import": "./dist/overlay-controller.js"
    },
    "./fit": {
      "types": "./dist/fit-controller.d.ts",
      "bun": "./src/fit-controller.ts",
      "import": "./dist/fit-controller.js"
    }
  },
  "files": [
    "dist/**",
    "src/**"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "prepack": "cp ../../../LICENSE . && cp ../../../README.md .",
    "postpack": "rm -f LICENSE && rm -f README.md"
  },
  "devDependencies": {
    "@telorun/sdk": "workspace:*",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "@telorun/sdk": "*"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.10"
  }
}
