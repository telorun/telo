      "frame": "0000007302000000697b226964223a372c227061796c6f6164223a7b22696e7374616e6365223a226831222c226d657373616765223a226c697374656e696e67222c227365766572697479223a397d2c2273657373696f6e223a227331222c2274797065223a224c6f672e5772697465227d68656c6c6f",
      "reason": "Channel.Data is the only data frame"
