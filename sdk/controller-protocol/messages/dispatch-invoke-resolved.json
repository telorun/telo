{
  "name": "Dispatch.InvokeResolved",
  "direction": "controller-to-kernel",
  "spec": "6. Invocation",
  "request": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "invokeContext": {
        "description": "The out-of-band second argument of a dispatch. The durable run handle is deliberately absent: it is a live object the kernel carries and never calls.",
        "type": "object",
        "required": [
          "cancellation"
        ],
        "properties": {
          "cancellation": {
            "type": "object",
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "cancelled": {
                "type": "boolean"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "invocationId": {
            "type": "integer",
            "minimum": 0
          },
          "parentInvocationId": {
            "type": "integer",
            "minimum": 0
          },
          "traceId": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "zones": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/zoneEntry"
            }
          },
          "durablePath": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "refIdentity": {
        "description": "Where an instance was declared: its kind, its name, and the declaration site.",
        "type": "object",
        "required": [
          "kind",
          "name"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "origin": {
            "type": "object",
            "properties": {
              "module": {
                "type": "string"
              },
              "pointer": {
                "type": "string",
                "pattern": "^(/([^/~]|~[01])*)*$"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "resourceHandle": {
        "description": "A live resource instance, by the id the kernel minted for it.",
        "type": "object",
        "required": [
          "id",
          "ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "$ref": "#/definitions/refIdentity"
          }
        },
        "additionalProperties": false
      },
      "zoneEntry": {
        "description": "One open execution zone — three identities and nothing else.",
        "type": "object",
        "required": [
          "kind",
          "provider"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"
          },
          "provider": {
            "$ref": "#/definitions/resourceHandle"
          },
          "key": {
            "$ref": "#/definitions/resourceHandle"
          }
        },
        "additionalProperties": false
      }
    },
    "description": "Dispatch through the same chokepoint at an instance the caller already resolved, so the invocation keeps the target's identity for tracing and error wrapping.",
    "type": "object",
    "properties": {
      "instance": {
        "type": "string",
        "minLength": 1
      },
      "target": {
        "$ref": "#/definitions/resourceHandle"
      },
      "inputs": {
        "description": "The call's inputs."
      },
      "context": {
        "$ref": "#/definitions/invokeContext"
      }
    },
    "required": [
      "instance",
      "target",
      "inputs"
    ],
    "additionalProperties": false
  },
  "response": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "The dispatch's result.",
    "type": "object",
    "properties": {
      "result": {
        "description": "The result."
      }
    },
    "additionalProperties": false
  },
  "errors": [
    "ERR_INPUT_INVALID",
    "ERR_OUTPUT_INVALID",
    "ERR_CONTRACT_UNRESOLVABLE",
    "ERR_RESOURCE_NOT_INVOKABLE",
    "ERR_INVOKE_CANCELLED",
    "ERR_DURABLE_SUSPENDED"
  ],
  "synchronous": false,
  "reentrant": true
}
