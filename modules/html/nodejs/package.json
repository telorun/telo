{
  "name": "@telorun/html-build",
  "version": "0.2.0",
  "private": true,
  "description": "Build-only package for the std/html module's bundled controller. Never published — the controller ships inside the module artifact as a pkg:telo/local/js bundle. This package exists to declare the dependencies esbuild inlines and to TYPE-CHECK the source, which esbuild does not do.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "@exodus/bytes": "^1.16.0",
    "@mozilla/readability": "^0.6.0",
    "css-selector-parser": "^3.3.0",
    "entities": "^8.1.0",
    "hast-util-from-parse5": "^8.0.3",
    "hast-util-to-mdast": "^10.1.2",
    "hast-util-to-text": "^4.0.2",
    "html-encoding-sniffer": "^7.0.0",
    "linkedom": "^0.18.13",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@telorun/sdk": "workspace:*",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.0.0",
    "esbuild": "catalog:",
    "typescript": "^5.0.0"
  }
}
