  "undecodable": [
    {
      "name": "a truncated length prefix",
      "frame": "0000",
      "reason": "the four length bytes are not all there, so no frame has begun"
    },
    {
      "name": "a length one byte over MAX_FRAME_LENGTH",
      "frame": "01000001",
      "reason": "16777217 exceeds MAX_FRAME_LENGTH, and the refusal is made on the length field alone — a reader that allocated first could be exhausted with four bytes"
