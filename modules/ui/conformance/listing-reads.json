{
  "description": "The exact requests a listing's read plan sends: for one read of the plan's product, its first page, the next page, the reload of the pages loaded, or a grouping's values. Produced by `ui`'s own plan requests and held by every renderer's.",
  "rows": [
    {
      "name": "a board column reads its group's records under every filter and the viewer's sort",
      "listing": {
        "basePath": "/api/tasks",
        "pageSize": 25,
        "paging": "pages",
        "filters": [
          [
            "projectId",
            "7"
          ]
        ],
        "bar": [
          [
            "title.contains",
            "plan"
          ]
        ],
        "sort": "-dueOn"
      },
      "reads": {
        "groups": {
          "property": "status",
          "values": "all",
          "enum": [
            "open",
            "doing",
            "done"
          ],
          "labels": []
        }
      },
      "read": {
        "group": "doing"
      },
      "event": "open",
      "requests": [
        {
          "path": "/api/tasks",
          "params": [
            [
              "limit",
              "25"
            ],
            [
              "sort",
              "-dueOn"
            ],
            [
              "projectId",
              "7"
            ],
            [
              "title.contains",
              "plan"
            ],
            [
              "status",
              "doing"
            ]
          ]
        }
      ]
    },
